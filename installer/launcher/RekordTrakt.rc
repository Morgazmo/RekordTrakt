#include <winver.h>
#include "version.h"        /* VERSION_COMMAS and VERSION_TEXT, written by installer/build.py */

1 ICON "..\\..\\assets\\icon\\rekordtrakt.ico"
1 24 "RekordTrakt.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_COMMAS
PRODUCTVERSION VERSION_COMMAS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Morgazmo"
            VALUE "FileDescription", "RekordTrakt"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "RekordTrakt"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "RekordTrakt.exe"
            VALUE "ProductName", "RekordTrakt"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
